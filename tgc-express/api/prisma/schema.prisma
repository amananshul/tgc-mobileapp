generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ProfileIntent {
  LEARN
  EARN
  ENTERTAIN
}

enum EventCategory {
  WORKSHOP
  OPEN_MIC
  FITNESS
  MUSIC
  ART
  TECH
  SOCIAL
  VOLUNTEER
  OTHER
}

enum EventVisibility {
  PUBLIC
  TRIBE_ONLY
  PRIVATE
}

enum ProfileMode {
  USER
  HOST
}

enum UserRole {
  USER
  HOST
  ADMIN
}

enum TribeVisibility {
  PUBLIC
  PRIVATE
}

enum TribeMemberRole {
  MEMBER
  MODERATOR
  OWNER
}

model User {
  id            String    @id @default(uuid())
  email         String    @unique
  supabaseId    String?   @unique
  passwordHash  String
  phone         String?   @unique
  phoneVerified Boolean   @default(false)
  otpCode       String?
  otpExpiry     DateTime?
  role          UserRole  @default(USER)
  onboardingCompleted Boolean @default(false)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  profile        Profile?
  refreshTokens  RefreshToken[]
  tribes         UserTribe[]
  createdTribes  Tribe[]              @relation("TribeCreator")
  tribePosts     TribePost[]
  createdEvents  Event[]              @relation("EventCreator")
  deletedEvents  Event[]              @relation("EventDeleter")
  eventCollaborations EventCollaborator[]
  eventRegistrations  EventRegistration[]
}

model RefreshToken {
  id        String   @id @default(uuid())
  tokenHash String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Profile {
  id             String   @id @default(uuid())
  userId         String   @unique
  intent         ProfileIntent?
  growthIntent   String[] @default([])
  avatarPath     String?
  username       String?  @unique
  fullName       String?
  city           String?
  bio            String?  @db.VarChar(120)
  shortBio       String?  @db.VarChar(140)
  interests      String[] @default([])
  skills         String[] @default([])
  activeMode     ProfileMode @default(USER)
  onboardingStep Int      @default(0)
  isOnboarded    Boolean  @default(false)
  karmaPoints    Int      @default(0)
  updatedAt      DateTime @updatedAt

  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Tribe {
  id            String          @id @default(uuid())
  name          String          @unique
  slug          String          @unique
  description   String?         @db.VarChar(300)
  coverImagePath String?
  category      String          @default("general")
  visibility    TribeVisibility @default(PUBLIC)
  memberCount   Int             @default(0)
  createdById   String?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  createdBy     User?           @relation("TribeCreator", fields: [createdById], references: [id])
  members       UserTribe[]
  posts         TribePost[]
  events        Event[]

  @@index([category])
  @@index([slug])
}

model UserTribe {
  id        String          @id @default(uuid())
  userId    String
  tribeId   String
  role      TribeMemberRole @default(MEMBER)
  joinedAt  DateTime        @default(now())

  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  tribe     Tribe           @relation(fields: [tribeId], references: [id], onDelete: Cascade)

  @@unique([userId, tribeId])
  @@index([tribeId])
  @@index([userId])
}

model TribePost {
  id        String   @id @default(uuid())
  tribeId    String
  userId     String
  content    String   @db.VarChar(2000)
  imagePath  String?
  createdAt  DateTime @default(now())

  tribe      Tribe    @relation(fields: [tribeId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tribeId])
  @@index([userId])
  @@index([tribeId, createdAt])
}

model Event {
  id                String          @id @default(uuid())
  title             String
  slug              String          @unique
  description       String?         @db.VarChar(2000)
  category          EventCategory   @default(OTHER)
  city              String
  venueName         String?
  addressText       String?
  startAt           DateTime
  endAt             DateTime?
  coverImageUrl     String?
  visibility        EventVisibility @default(PUBLIC)
  capacity          Int?
  registrationCount Int             @default(0)
  tribeId           String?
  createdById       String
  isDeleted         Boolean         @default(false)
  deletedAt         DateTime?
  deletedById       String?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  tribe             Tribe?              @relation(fields: [tribeId], references: [id])
  createdBy         User                @relation("EventCreator", fields: [createdById], references: [id])
  deletedBy         User?               @relation("EventDeleter", fields: [deletedById], references: [id])
  collaborators     EventCollaborator[]
  registrations     EventRegistration[]

  @@index([startAt])
  @@index([city])
  @@index([tribeId])
  @@index([createdById])
  @@index([isDeleted])
}

model EventCollaborator {
  id      String @id @default(uuid())
  eventId String
  userId  String
  role    String @default("COHOST")

  event   Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([eventId, userId])
  @@index([eventId])
  @@index([userId])
}

model EventRegistration {
  id        String   @id @default(uuid())
  eventId   String
  userId    String
  status    String   @default("REGISTERED")
  passCode  String   @unique
  createdAt DateTime @default(now())

  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([eventId, userId])
  @@index([eventId])
  @@index([userId])
}
